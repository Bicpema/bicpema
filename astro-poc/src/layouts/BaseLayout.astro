---
import "../styles/global.css";
import "../styles/simulation-link.css";

interface Props {
  title?: string;
  description?: string;
  math?: boolean;
}

const { title, description = "", math = false } = Astro.props;
const pageTitle = title ? `${title} :: Bicpema` : "Bicpema";
---

<!doctype html>
<html lang="ja-JP">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.ico" />
    <!-- テーマと同じく、描画前にダークモードのクラスを付与してちらつきを防ぐ -->
    <script is:inline>
      if (localStorage.theme === "dark" || (!("theme" in localStorage) && matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
    </script>
    {
      math && (
        <Fragment>
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" crossorigin="anonymous" />
          <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" crossorigin="anonymous" />
          <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" crossorigin="anonymous" />
          <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
              renderMathInElement(document.body, {
                delimiters: [
                  { left: "$$", right: "$$", display: true },
                  { left: "$", right: "$", display: false },
                  { left: "\\(", right: "\\)", display: false },
                  { left: "\\[", right: "\\]", display: true }
                ],
                throwOnError: false
              });
            });
          </script>
        </Fragment>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/"><img src="/logo.svg" alt="" width="32" height="32" />Bicpema</a>
      <nav>
        <a href="/post/">シミュレーション一覧</a>
        <a href="/tags/">タグ</a>
        <button type="button" id="theme-toggle" aria-label="ダークモードの切り替え">◐</button>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">© 2022 - {new Date().getFullYear()} BICPEMA</footer>
    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        localStorage.theme = dark ? "dark" : "light";
      });
    </script>
  </body>
</html>
