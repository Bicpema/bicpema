---
// layouts/shortcodes/simulation-link.html に相当するカード。
// MDXの記事や一覧ページから <SimulationLink href="/vite/simulations/<名前>/" title=... image=... /> として使う。
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  image?: string | ImageMetadata;
}

const { href, title, image } = Astro.props;
if (!/^\/vite\/simulations\/[A-Za-z0-9_-]+\/$/.test(href)) {
  throw new Error(`SimulationLink: "/vite/simulations/<名前>/" 形式のパスを指定してください（${href}）`);
}
---

<a class="not-prose simulation-link" href={href}>
  {
    typeof image === "string" ? (
      <img class="simulation-link__thumbnail" src={image} alt="" loading="lazy" />
    ) : image ? (
      <Image class="simulation-link__thumbnail" src={image} alt="" loading="lazy" />
    ) : null
  }
  <span class="simulation-link__body">
    <span class="simulation-link__label">シミュレーション</span>
    <span class="simulation-link__title">{title}</span>
    <span class="simulation-link__button">
      シミュレーションを開く
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
    </span>
  </span>
</a>
