{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM"],
    "types": ["node", "p5"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "vite/types/**/*.ts",
    "vite/_build/**/*.js",
    "vite/simulations/free-fall/**/*.js",
    "vite/simulations/uniform-linear-motion/**/*.js",
    "vite/simulations/uniformly-accelerated-linear-motion/**/*.js",
    "vite/simulations/vertical-throw-up/**/*.js",
    "vite/simulations/vertical-throw-down/**/*.js",
    "vite/simulations/horizontal-throw/**/*.js",
    "vite/simulations/projectile-motion/**/*.js",
    "vite/simulations/train-acceleration/**/*.js",
    "vite/simulations/velocity-composition/**/*.js",
    "vite/simulations/conservation-of-heat-and-specific-heat/**/*.js",
    "vite/simulations/first-law-of-thermodynamics/**/*.js",
    "vite/simulations/heat-engine/**/*.js",
    "vite/simulations/specific-heat-and-heat-capacity/**/*.js",
    "vite/simulations/visualization-of-heat-transfer/**/*.js",
    "vite/simulations/half-life/**/*.js",
    "vite/simulations/archimedes-principle/**/*.js",
    "vite/simulations/3d-strata/**/*.js",
    "vite/simulations/3d-strata-csv/**/*.js",
    "vite/simulations/force-composition/**/*.js",
    "vite/simulations/force-decomposition/**/*.js",
    "vite/simulations/force-and-acceleration/**/*.js",
    "vite/simulations/normal-force/**/*.js",
    "vite/simulations/three-force-equilibrium/**/*.js",
    "vite/simulations/slope-force-decomposition/**/*.js",
    "vite/simulations/slope-cart-motion/**/*.js",
    "vite/simulations/cart-work-ruler/**/*.js",
    "vite/simulations/air-column/**/*.js",
    "vite/simulations/doppler/**/*.js",
    "vite/simulations/oscilloscope/**/*.js",
    "vite/simulations/standing-wave/**/*.js",
    "vite/simulations/tate-yoko-wave/**/*.js",
    "vite/simulations/wave-machine/**/*.js",
    "vite/simulations/wave-reflection/**/*.js",
    "vite/simulations/pendulum-wave/**/*.js",
    "vite/simulations/elastic-force/**/*.js",
    "vite/simulations/spring/**/*.js",
    "vite/simulations/pendulum/**/*.js",
    "vite/simulations/*/js/**/*.ts",
    "test/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "static",
    "public",
    "templates",
    "test/**/fixtures"
  ]
}
