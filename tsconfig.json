{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM"],
    "types": ["node", "p5"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "vite/types/**/*.ts",
    "vite/_build/**/*.js",
    "vite/simulations/**/*.js",
    "vite/simulations/*/js/**/*.ts",
    "test/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "static",
    "public",
    "templates",
    "test/**/fixtures",
    "vite/simulations/2025_DGI_cellophane-color2_ELK",
    "vite/simulations/cellophane",
    "vite/simulations/cellophane-color-2D_animation",
    "vite/simulations/cellophane_display",
    "vite/simulations/lens",
    "vite/simulations/magnetic-field-straight",
    "vite/simulations/refraction",
    "vite/simulations/transformer"
  ]
}
