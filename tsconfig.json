{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM"],
    "types": ["node", "p5"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    // templates/ts/*.ts は vite/simulations/<name>/ts/ に配置される前提で
    // "../../../ts/..." を import するため、リポジトリの親ディレクトリと vite/ を
    // 同一の仮想ルートとみなして vite/ts/ に解決させる
    "rootDirs": ["..", "vite"]
  },
  "include": [
    "vite/types/**/*.ts",
    "vite/_build/**/*.js",
    "vite/ts/**/*.ts",
    "vite/simulations/**/*.ts",
    "test/**/*.js",
    "templates/ts/**/*.ts"
  ],
  "exclude": ["node_modules", "static", "test/**/fixtures", "test/e2e"]
}
