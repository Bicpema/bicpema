{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM"],
    "types": ["node", "p5"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "test/**/*.js",
    "scripts/**/*.js",
    "src/**/*.ts",
    "src/**/*.mjs",
    "astro.config.mjs",
    ".astro/types.d.ts"
  ],
  "exclude": ["node_modules", "dist", "test/**/fixtures"]
}
