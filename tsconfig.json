{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM"],
    "types": ["node", "p5"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "vite/types/**/*.ts",
    "vite/_build/**/*.js",
    "vite/ts/**/*.ts",
    "vite/simulations/**/*.ts",
    "vite/_templates/**/*.ts",
    "test/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": ["node_modules", "static", "test/**/fixtures"]
}
