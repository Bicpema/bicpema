{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "p5"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "vite/types/**/*.ts",
    "vite/_build/**/*.js",
    "vite/simulations/free-fall/**/*.js",
    "vite/simulations/*/js/**/*.ts",
    "templates/**/*.ts",
    "test/**/*.js"
  ],
  "exclude": ["node_modules", "static", "public"]
}
