---
// ヘッダーの検索。ボタン（または「/」キー・Ctrl+K）で検索ダイアログを開き、
// /search.json（src/pages/search.json.ts）の記事一覧からタイトル・説明・タグ・カテゴリーを絞り込む。
import Icon from "./Icon.astro";
---

<button
  type="button"
  class="flex h-9 items-center gap-2 rounded-lg border border-slate-300 bg-white px-2.5 text-sm whitespace-nowrap text-slate-500 transition-colors hover:border-slate-400 hover:text-slate-700 sm:w-48 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-slate-200"
  aria-label="シミュレーションを検索"
  aria-haspopup="dialog"
  data-search-open
>
  <Icon name="search" size={16} />
  <span class="hidden sm:inline">教材を検索</span>
  <kbd class="ml-auto hidden rounded border border-slate-300 px-1.5 font-sans text-xs text-slate-400 sm:inline dark:border-slate-600">
    /
  </kbd>
</button>

<dialog
  id="searchDialog"
  aria-label="シミュレーションを検索"
  class="mx-auto mt-[10vh] w-[min(40rem,calc(100%-2rem))] overflow-hidden rounded-xl border border-slate-200 bg-white p-0 text-slate-800 shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
>
  <div class="flex items-center gap-3 border-b border-slate-200 px-4 dark:border-slate-700">
    <Icon name="search" size={18} class="text-slate-400" />
    <input
      id="searchInput"
      type="search"
      placeholder="教材名・キーワード・タグで検索"
      autocomplete="off"
      aria-controls="searchResults"
      aria-describedby="searchStatus"
      class="h-14 min-w-0 flex-1 bg-transparent text-base outline-none placeholder:text-slate-400 focus-visible:outline-none"
    />
    <button
      type="button"
      class="rounded border border-slate-300 px-1.5 py-0.5 text-xs text-slate-500 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-400 dark:hover:bg-slate-800"
      data-search-close
    >
      Esc
    </button>
  </div>
  <ul
    id="searchResults"
    class="max-h-[60vh] overflow-y-auto p-2"
    role="list"
  ></ul>
  <p
    id="searchStatus"
    class="px-4 pb-4 text-sm text-slate-500 dark:text-slate-400"
    aria-live="polite"
  ></p>
</dialog>

<script>
  interface SearchEntry {
    title: string;
    description: string;
    url: string;
    image?: string;
    category?: string;
    tags: string[];
  }

  const dialog = document.querySelector<HTMLDialogElement>("#searchDialog")!;
  const input = document.querySelector<HTMLInputElement>("#searchInput")!;
  const results = document.querySelector<HTMLUListElement>("#searchResults")!;
  const status = document.querySelector<HTMLParagraphElement>("#searchStatus")!;
  const MAX_RESULTS = 12;
  let entries: SearchEntry[] | undefined;
  let activeIndex = -1;

  /** 大文字小文字・全角半角・カタカナとひらがなの違いを無視して比較するための正規化 */
  const normalize = (text: string) =>
    text
      .normalize("NFKC")
      .toLowerCase()
      .replace(/[ァ-ヶ]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60));

  const loadEntries = async () => {
    if (!entries) {
      const response = await fetch("/search.json");
      entries = (await response.json()) as SearchEntry[];
    }
    return entries;
  };

  const links = () => [...results.querySelectorAll<HTMLAnchorElement>("a")];

  const setActive = (index: number) => {
    const items = links();
    activeIndex =
      items.length === 0 ? -1 : (index + items.length) % items.length;
    items.forEach((link, i) => {
      const active = i === activeIndex;
      link.dataset.active = String(active);
      if (active) {
        link.scrollIntoView({ block: "nearest" });
      }
    });
  };

  const render = (matches: SearchEntry[], query: string) => {
    results.replaceChildren(
      ...matches.slice(0, MAX_RESULTS).map((entry) => {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = entry.url;
        link.className =
          "flex items-center gap-3 rounded-lg p-2 hover:bg-slate-100 data-[active=true]:bg-blue-50 dark:hover:bg-slate-800 dark:data-[active=true]:bg-slate-800";
        if (entry.image) {
          const image = document.createElement("img");
          image.src = entry.image;
          image.alt = "";
          image.className =
            "h-12 w-20 shrink-0 rounded object-cover bg-slate-100 dark:bg-slate-800";
          link.append(image);
        }
        const text = document.createElement("span");
        text.className = "min-w-0";
        const title = document.createElement("span");
        title.className = "block font-semibold";
        title.textContent = entry.title;
        const meta = document.createElement("span");
        meta.className =
          "block truncate text-sm text-slate-500 dark:text-slate-400";
        meta.textContent = [
          ...new Set([entry.category, ...entry.tags].filter(Boolean))
        ]
          .slice(0, 5)
          .join(" ・ ");
        text.append(title, meta);
        link.append(text);
        item.append(link);
        return item;
      })
    );
    activeIndex = -1;
    if (query === "") {
      status.textContent = `${matches.length}件の教材があります。キーワードを入力してください。`;
    } else if (matches.length === 0) {
      status.textContent = `「${query}」に一致する教材は見つかりませんでした。`;
    } else {
      status.textContent = `${matches.length}件の教材が見つかりました。`;
    }
  };

  const search = async () => {
    const all = await loadEntries();
    const query = input.value.trim();
    const terms = normalize(query).split(/\s+/).filter(Boolean);
    const scored = all
      .map((entry) => {
        const title = normalize(entry.title);
        const text = normalize(
          [entry.title, entry.description, entry.category, ...entry.tags].join(
            " "
          )
        );
        if (!terms.every((term) => text.includes(term))) {
          return null;
        }
        const score = terms.filter((term) => title.includes(term)).length;
        return { entry, score };
      })
      .filter((match) => match !== null)
      .sort((a, b) => b.score - a.score);
    render(
      scored.map((match) => match.entry),
      query
    );
  };

  const open = async () => {
    if (!dialog.open) {
      dialog.showModal();
      input.select();
      await search();
    }
  };

  for (const button of document.querySelectorAll("[data-search-open]")) {
    button.addEventListener("click", open);
  }
  dialog
    .querySelector("[data-search-close]")!
    .addEventListener("click", () => dialog.close());
  // ダイアログの外側（背景）をクリックしたら閉じる
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });
  input.addEventListener("input", search);
  input.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      setActive(activeIndex + (event.key === "ArrowDown" ? 1 : -1));
    } else if (event.key === "Enter") {
      const link = links()[activeIndex] ?? links()[0];
      if (link) {
        event.preventDefault();
        link.click();
      }
    }
  });
  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement;
    const typing =
      target.isContentEditable ||
      /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
    if (
      (event.key === "/" && !typing) ||
      (event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey))
    ) {
      event.preventDefault();
      open();
    }
  });
</script>
