---
// 一覧ページなどの見出し（パンくずリスト・タイトル・説明）。
import Icon from "./Icon.astro";

interface Props {
  title: string;
  description?: string;
  /** パンくずリスト（最後の項目は現在のページとして扱う） */
  breadcrumbs?: { href?: string; label: string }[];
}

const { title, description, breadcrumbs = [] } = Astro.props;
---

<div class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/40">
  <div class="mx-auto max-w-6xl px-4 py-10">
    {breadcrumbs.length > 0 && (
      <nav
        aria-label="パンくずリスト"
        class="mb-3 text-sm text-slate-500 dark:text-slate-400"
      >
        <ol class="flex flex-wrap items-center gap-1">
          <li>
            <a href="/" class="hover:text-blue-700 dark:hover:text-blue-300">
              ホーム
            </a>
          </li>
          {breadcrumbs.map((crumb) => (
            <li class="flex items-center gap-1">
              <Icon name="chevron-right" size={12} />
              {crumb.href ? (
                <a
                  href={crumb.href}
                  class="hover:text-blue-700 dark:hover:text-blue-300"
                >
                  {crumb.label}
                </a>
              ) : (
                <span aria-current="page">{crumb.label}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    {description && (
      <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-400">
        {description}
      </p>
    )}
    <slot />
  </div>
</div>
