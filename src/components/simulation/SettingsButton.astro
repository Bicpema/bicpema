---
// 設定モーダルを開くボタン。開閉は initModal() の `.settings-modal-open` で行う。
interface Props {
  /** ボタンに付与するid */
  id?: string;
  /** ラッパーの配置クラス（未指定時は右上） */
  class?: string;
}

const {
  id,
  class:
    positionClass = "absolute top-5 right-5 z-[1000] max-[576px]:top-2.5 max-[576px]:right-2.5"
} = Astro.props;
---

<div class={positionClass}>
  <button
    type="button"
    id={id}
    class="settings-modal-open btn-settings-modal-open"
    aria-label="シミュレーションの設定"
  >
    ⚙ 設定
  </button>
</div>
