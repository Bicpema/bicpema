---
import SimulationLayout from "../../layouts/SimulationLayout.astro";
import NavBar from "../../components/simulation/NavBar.astro";
import LoadingSpinner from "../../components/simulation/LoadingSpinner.astro";
import Icon from "../../components/Icon.astro";

const title = "3D地層観察";
---

<SimulationLayout title={title} class="bg-neutral-900" disableContextMenu>
  <NavBar title={title} />
  <!-- シミュレーション画面 -->
  <div class="w-full p-0 mt-[60px]" id="p5Container">
    <div
      class="absolute start-0 m-3 hidden w-full rounded-lg border border-neutral-300 bg-white shadow-lg sm:w-6/12 lg:w-1/4"
      id="collapse"
    >
      <div class="p-4">
        <ul class="m-0 list-none p-0">
          <li class="border-b border-neutral-100 py-2 last:border-b-0">
            <div class="flex items-center justify-between gap-2">
              <div class="flex-1">砂岩層</div>
              <div class="h-6 w-10 rounded bg-[rgba(215,205,166,0.7843)]"></div>
            </div>
          </li>
          <li class="border-b border-neutral-100 py-2 last:border-b-0">
            <div class="flex items-center justify-between gap-2">
              <div class="flex-1">泥岩層</div>
              <div class="h-6 w-10 rounded bg-[rgba(156,154,143,0.7843)]"></div>
            </div>
          </li>
          <li class="border-b border-neutral-100 py-2 last:border-b-0">
            <div class="flex items-center justify-between gap-2">
              <div class="flex-1">れき岩層</div>
              <div class="h-6 w-10 rounded bg-[rgba(252,180,172,0.7843)]"></div>
            </div>
          </li>
          <li class="border-b border-neutral-100 py-2 last:border-b-0">
            <div class="flex items-center justify-between gap-2">
              <div class="flex-1">石灰岩層</div>
              <div class="h-6 w-10 rounded bg-[rgba(120,170,170,0.7843)]"></div>
            </div>
          </li>
          <li class="border-b border-neutral-100 py-2 last:border-b-0">
            <div class="flex items-center justify-between gap-2">
              <div class="flex-1">凝灰岩層・火山灰層</div>
              <div class="h-6 w-10 rounded bg-[rgba(200,200,200,0.7843)]"></div>
            </div>
          </li>
          <li class="border-b border-neutral-100 py-2 last:border-b-0">
            <div class="flex items-center justify-between gap-2">
              <div class="flex-1">ローム層</div>
              <div class="h-6 w-10 rounded bg-[rgba(112,58,21,0.7843)]"></div>
            </div>
          </li>
          <li class="py-2">
            <div class="flex items-center justify-between gap-2">
              <div class="flex-1">その他の層</div>
              <div class="h-6 w-10 rounded bg-[rgba(0,0,0,0.7843)]"></div>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- モーダル -->
    <div
      class="fixed inset-0 z-[1100] hidden flex items-center justify-center bg-black/50"
      id="dataRegisterModal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dataRegisterModalLabel"
      aria-hidden="true"
      tabindex="-1"
    >
      <div class="flex max-h-[85vh] w-full max-w-4xl flex-col overflow-hidden rounded bg-white">
        <div class="flex items-center gap-2 border-b border-neutral-200 p-4">
          <Icon name="clipboard2-data" size={48} class="pb-1" />
          <h1 class="flex-1 text-lg font-semibold" id="dataRegisterModalLabel">
            データの登録
          </h1>
          <button
            type="button"
            class="modal-close modal-close-icon"
            aria-label="Close"
          >
            &times;
          </button>
        </div>
        <div class="overflow-y-auto p-4">
          <div
            class="mb-4 flex items-center gap-2 rounded border border-blue-200 bg-blue-50 p-3 text-blue-900"
            role="alert"
          >
            <Icon name="check-circle" size={16} />
            <div>
              地点データ、地層データ、表示する平面の順に登録してください。
            </div>
          </div>
          <ul class="nav-tabs m-0 mb-4 flex list-none gap-1 border-b border-b-[#dee2e6] p-0">
            <li>
              <a
                class="nav-link inline-block cursor-pointer rounded-t-md border border-transparent px-4 py-2 text-[#495057] no-underline hover:border-t-[#e9ecef] hover:border-x-[#e9ecef] hover:border-b-[#dee2e6] [&.active]:border-t-[#dee2e6] [&.active]:border-x-[#dee2e6] [&.active]:border-b-white [&.active]:bg-white [&.active]:font-bold active"
                aria-current="page"
                href="#placePointNameRegister"
              >
                地点データの登録
              </a>
            </li>
            <li>
              <a
                class="nav-link inline-block cursor-pointer rounded-t-md border border-transparent px-4 py-2 text-[#495057] no-underline hover:border-t-[#e9ecef] hover:border-x-[#e9ecef] hover:border-b-[#dee2e6] [&.active]:border-t-[#dee2e6] [&.active]:border-x-[#dee2e6] [&.active]:border-b-white [&.active]:bg-white [&.active]:font-bold"
                href="#placePointDataRegister"
              >
                地層データの登録
              </a>
            </li>
            <li>
              <a
                class="nav-link inline-block cursor-pointer rounded-t-md border border-transparent px-4 py-2 text-[#495057] no-underline hover:border-t-[#e9ecef] hover:border-x-[#e9ecef] hover:border-b-[#dee2e6] [&.active]:border-t-[#dee2e6] [&.active]:border-x-[#dee2e6] [&.active]:border-b-white [&.active]:bg-white [&.active]:font-bold"
                href="#planeDataRegister"
              >
                表示する平面の登録
              </a>
            </li>
          </ul>
          <div>
            <div id="placePointNameRegister">
              <div class="container">
                <h2 class="mt-4 flex items-center gap-2">
                  <Icon name="cursor" size={32} class="pb-2" />
                  地点データの登録
                </h2>
                <button
                  class="mb-2 inline-flex items-center gap-1.5 rounded border border-blue-600 bg-white px-3 py-1.5 text-blue-600 hover:bg-blue-50"
                  id="placeAddButton"
                >
                  <Icon name="plus-circle" size={20} class="pb-1" />
                  追加
                </button>
                <button
                  class="mb-2 inline-flex items-center gap-1.5 rounded border border-red-600 bg-white px-3 py-1.5 text-red-600 hover:bg-red-50"
                  id="placeRemoveButton"
                >
                  <Icon name="dash-circle" size={20} class="pb-1" />
                  削除
                </button>
                <div
                  class="flex flex-wrap gap-2"
                  id="placePointNameInput"
                ></div>
              </div>
            </div>
            <div class="hidden" id="placePointDataRegister">
              <div class="container">
                <h2 class="mt-3 flex items-center gap-2">
                  <Icon name="layers" size={32} class="pb-2" />
                  地層データの登録
                </h2>
                <p>※地層データ登録用のサブウィンドウが開きます。</p>
                <div
                  class="flex flex-wrap gap-2"
                  id="placePointDataInput"
                ></div>
              </div>
            </div>
            <div class="hidden" id="planeDataRegister">
              <div class="container">
                <div class="container">
                  <h2 class="mt-2 flex items-center gap-2">
                    <Icon name="cursor" size={32} class="pb-2" />
                    平面を構成する地点の組み合わせ
                  </h2>
                  <table class="w-full border-collapse text-sm">
                    <thead>
                      <tr>
                        <th
                          class="border border-neutral-300 bg-neutral-100 px-2 py-1 text-center"
                          style="width: 33%"
                        >
                          １つめの地点
                        </th>
                        <th
                          class="border border-neutral-300 bg-neutral-100 px-2 py-1 text-center"
                          style="width: 33%"
                        >
                          ２つめの地点
                        </th>
                        <th
                          class="border border-neutral-300 bg-neutral-100 px-2 py-1 text-center"
                          style="width: 33%"
                        >
                          ３つめの地点
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td class="border border-neutral-300 px-2 py-1">
                          <select
                            class="form-control"
                            id="firstPlaceSelect"
                          ></select>
                        </td>
                        <td class="border border-neutral-300 px-2 py-1">
                          <select
                            class="form-control"
                            id="secondPlaceSelect"
                          ></select>
                        </td>
                        <td class="border border-neutral-300 px-2 py-1">
                          <select
                            class="form-control"
                            id="thirdPlaceSelect"
                          ></select>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <div class="container border-top">
                  <h2 class="mt-2 flex items-center gap-2">
                    <Icon name="layers" size={32} class="pb-2" />
                    表示する地層の組み合わせ
                  </h2>
                  <button
                    class="mb-2 inline-flex items-center gap-1.5 rounded border border-blue-600 bg-white px-3 py-1.5 text-blue-600 hover:bg-blue-50"
                    id="strataAddButton"
                  >
                    <Icon name="plus-circle" size={20} class="pb-1" />
                    追加
                  </button>
                  <button
                    class="mb-2 inline-flex items-center gap-1.5 rounded border border-red-600 bg-white px-3 py-1.5 text-red-600 hover:bg-red-50"
                    id="strataRemoveButton"
                  >
                    <Icon name="dash-circle" size={20} class="pb-1" />
                    削除
                  </button>
                  <table class="w-full border-collapse text-sm">
                    <thead>
                      <tr>
                        <th
                          class="border border-neutral-300 bg-neutral-100 px-2 py-1 text-center"
                          style="width: 10%"
                        >
                          組番号
                        </th>
                        <th
                          class="border border-neutral-300 bg-neutral-100 px-2 py-1 text-center"
                          style="width: 22.5%"
                        >
                          層の種類
                        </th>
                        <th
                          class="border border-neutral-300 bg-neutral-100 px-2 py-1 text-center"
                          id="firstPlaceName"
                          style="width: 22.5%"
                        >
                          -
                        </th>
                        <th
                          class="border border-neutral-300 bg-neutral-100 px-2 py-1 text-center"
                          id="secondPlaceName"
                          style="width: 22.5%"
                        >
                          -
                        </th>
                        <th
                          class="border border-neutral-300 bg-neutral-100 px-2 py-1 text-center"
                          id="thirdPlaceName"
                          style="width: 22.5%"
                        >
                          -
                        </th>
                      </tr>
                    </thead>
                    <tbody id="strataSelect"></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="flex justify-end border-t border-neutral-200 p-4">
          <button type="button" class="modal-close modal-close-outline">
            閉じる
          </button>
        </div>
      </div>
    </div>

    <!-- ボタン -->
    <div class="absolute m-3 end-0">
      <button
        class="collapse-toggle inline-flex items-center gap-1.5 rounded-full bg-neutral-600 px-3 py-2 text-white hover:bg-neutral-500"
        type="button"
        aria-expanded="false"
        aria-controls="collapse"
      >
        凡例の表示・非表示
        <Icon name="activity" size={20} class="pb-1" />
      </button>
      <a
        class="inline-flex items-center gap-1.5 rounded-full bg-blue-600 px-3 py-2 text-white hover:bg-blue-500"
        id="screenshotButton"
        type="button"
      >
        スクリーンショット
        <Icon name="camera" size={20} class="pb-1" />
      </a>
      <button
        class="data-register-modal-open inline-flex items-center gap-1.5 rounded-full bg-blue-600 px-3 py-2 text-white hover:bg-blue-500"
        type="button"
      >
        データの登録
        <Icon name="plus-circle" size={20} class="pb-1" />
      </button>
    </div>
    <div class="absolute m-3 start-0 bottom-0">
      <button
        class="inline-flex items-center gap-1.5 rounded-full bg-green-600 px-3 py-2 text-white hover:bg-green-500"
        type="button"
        id="aSetButton"
      >
        Aセット
        <Icon name="bar-chart-line" size={20} class="pb-1" />
      </button>
      <button
        class="inline-flex items-center gap-1.5 rounded-full bg-green-600 px-3 py-2 text-white hover:bg-green-500"
        type="button"
        id="bSetButton"
      >
        Bセット
        <Icon name="bar-chart-line" size={20} class="pb-1" />
      </button>
      <button
        class="inline-flex items-center gap-1.5 rounded-full bg-green-600 px-3 py-2 text-white hover:bg-green-500"
        type="button"
        id="cSetButton"
      >
        Cセット
        <Icon name="bar-chart-line" size={20} class="pb-1" />
      </button>
      <button
        class="inline-flex items-center gap-1.5 rounded-full bg-green-600 px-3 py-2 text-white hover:bg-green-500"
        type="button"
        id="dSetButton"
      >
        Dセット
        <Icon name="bar-chart-line" size={20} class="pb-1" />
      </button>
      <button
        class="inline-flex items-center gap-1.5 rounded-full bg-green-600 px-3 py-2 text-white hover:bg-green-500"
        type="button"
        id="allSetButton"
      >
        全体
        <Icon name="bar-chart-line" size={20} class="pb-1" />
      </button>
    </div>
    <div class="flex justify-center" id="p5Canvas"></div>
  </div>
  <!-- ローディングスピナー（p5.jsの初回draw()実行時にts/index.tsで非表示にします） -->
  <LoadingSpinner />

  <script src="./ts/index.ts"></script>
</SimulationLayout>
