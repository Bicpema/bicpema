---
import SimulationLayout from "../../layouts/SimulationLayout.astro";
import NavBar from "../../components/simulation/NavBar.astro";
import LoadingSpinner from "../../components/simulation/LoadingSpinner.astro";
import SettingsButton from "../../components/simulation/SettingsButton.astro";
import SettingsModal from "../../components/simulation/SettingsModal.astro";

const title = "変圧器";
---

<SimulationLayout
  title={title}
  class="h-full overflow-hidden bg-neutral-900 p-0"
  disableContextMenu
>
  <NavBar title={title} />

  <div
    class="relative h-[calc(100vh-60px)] w-full overflow-hidden p-0 mt-[60px]"
    id="p5Container"
  >
    <div class="flex h-full w-full justify-center" id="p5Canvas"></div>

    <!-- 設定モーダル -->
    <SettingsModal
      id="settingsModal"
      variant="dark"
      panelClass="w-[360px] p-6 max-[576px]:w-[360px] max-[576px]:p-6"
    >
      <div class="mb-3">
        <span class="mb-1 block text-sm font-bold">位相</span>
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-1">
            <input
              class="h-4 w-4 accent-blue-600"
              type="radio"
              name="phase"
              id="phaseSame"
              value="true"
              checked
            />
            <label class="text-sm" for="phaseSame">
              同位相
            </label>
          </div>
          <div class="flex items-center gap-1">
            <input
              class="h-4 w-4 accent-blue-600"
              type="radio"
              name="phase"
              id="phaseOpposite"
              value="false"
            />
            <label class="text-sm" for="phaseOpposite">
              逆位相
            </label>
          </div>
        </div>
      </div>
      <div class="mb-3">
        <span class="mb-1 block text-sm font-bold">速度</span>
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-1">
            <input
              class="h-4 w-4 accent-blue-600"
              type="radio"
              name="speed"
              id="speedSlow"
              value="1"
              checked
            />
            <label class="text-sm" for="speedSlow">
              ゆっくり
            </label>
          </div>
          <div class="flex items-center gap-1">
            <input
              class="h-4 w-4 accent-blue-600"
              type="radio"
              name="speed"
              id="speedFast"
              value="5"
            />
            <label class="text-sm" for="speedFast">
              はやい
            </label>
          </div>
        </div>
      </div>
      <div class="mb-3 flex items-center justify-between">
        <span class="text-sm font-bold">一次コイル 巻数</span>
        <div class="flex items-center gap-2">
          <button
            class="rounded bg-blue-600 px-2 py-1 text-sm text-white hover:bg-blue-500"
            id="coil1MinusBtn"
          >
            ー
          </button>
          <button
            class="rounded bg-amber-500 px-2 py-1 text-sm text-neutral-900 hover:bg-amber-400"
            id="coil1PlusBtn"
          >
            ＋
          </button>
        </div>
      </div>
      <div class="mb-4 flex items-center justify-between">
        <span class="text-sm font-bold">二次コイル 巻数</span>
        <div class="flex items-center gap-2">
          <button
            class="rounded bg-blue-600 px-2 py-1 text-sm text-white hover:bg-blue-500"
            id="coil2MinusBtn"
          >
            ー
          </button>
          <button
            class="rounded bg-amber-500 px-2 py-1 text-sm text-neutral-900 hover:bg-amber-400"
            id="coil2PlusBtn"
          >
            ＋
          </button>
        </div>
      </div>
    </SettingsModal>

    <!-- 左下: 再生/一時停止・リセット -->
    <div class="absolute bottom-0 start-0 z-[1000] m-3 flex gap-2">
      <button
        id="playPauseButton"
        class="rounded bg-green-600 px-4 py-2 text-white hover:bg-green-500"
      >
        ▶ 開始
      </button>
      <button
        id="resetButton"
        class="rounded bg-neutral-600 px-4 py-2 text-white hover:bg-neutral-500"
      >
        🔄 リセット
      </button>
    </div>

    <!-- 右上: 設定ボタン -->
    <SettingsButton id="toggleModal" />
  </div>

  <!-- ローディングスピナー（p5.jsの初回draw()実行時にts/index.tsで非表示にします） -->
  <LoadingSpinner />

  <script src="./ts/index.ts"></script>
</SimulationLayout>
