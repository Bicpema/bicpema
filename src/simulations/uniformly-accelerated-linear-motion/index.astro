---
import SimulationLayout from "../../layouts/SimulationLayout.astro";
import NavBar from "../../components/simulation/NavBar.astro";
import LoadingSpinner from "../../components/simulation/LoadingSpinner.astro";
import SettingsButton from "../../components/simulation/SettingsButton.astro";
import SettingsModal from "../../components/simulation/SettingsModal.astro";

const title = "等加速度直線運動";
---

<SimulationLayout
  title={title}
  class="h-full overflow-hidden bg-neutral-900 p-0"
  disableContextMenu
>
  <NavBar title={title} />

  <div
    class="relative mt-[60px] h-[calc(100vh-60px)] w-full overflow-hidden p-0"
    id="p5Container"
  >
    <div class="flex h-full w-full justify-center" id="p5Canvas"></div>

    <!-- 設定モーダルパネル -->
    <SettingsModal id="settingsModal" variant="dark">
      <div class="mb-3">
        <label for="initialVelocityInput" class="form-label">
          初速度 v₀ (m/s)
        </label>
        <input
          type="number"
          class="form-control"
          id="initialVelocityInput"
          min="0"
          max="20"
          value="0"
          step="1"
        />
      </div>
      <div class="mb-3">
        <label for="accelerationInput" class="form-label">
          加速度 a (m/s²)
        </label>
        <input
          type="number"
          class="form-control"
          id="accelerationInput"
          min="0"
          max="10"
          value="2"
          step="1"
        />
      </div>
      <div class="mb-4 flex items-center gap-2">
        <input
          class="h-4 w-4 accent-blue-600"
          type="checkbox"
          id="showMarkersCheckBox"
          checked
        />
        <label class="text-sm" for="showMarkersCheckBox">
          等時間マーカーの表示
        </label>
      </div>
    </SettingsModal>

    <!-- 左下コントロール -->
    <div class="absolute bottom-5 left-5 z-[1000] flex flex-wrap gap-2.5 max-[576px]:bottom-2.5 max-[576px]:left-2.5 max-[576px]:gap-2">
      <button
        id="resetButton"
        class="rounded-lg bg-blue-600 px-5 py-2.5 text-base font-bold whitespace-nowrap text-white shadow-[0_4px_6px_rgba(0,0,0,0.3)] transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-[0_6px_8px_rgba(0,0,0,0.4)] active:translate-y-0 active:shadow-[0_2px_4px_rgba(0,0,0,0.3)] max-[576px]:px-[15px] max-[576px]:py-2 max-[576px]:text-sm max-[400px]:px-3 max-[400px]:py-1.5 max-[400px]:text-xs"
      >
        🔄 リセット
      </button>
      <button
        id="playPauseButton"
        class="rounded-lg bg-green-600 px-5 py-2.5 text-base font-bold whitespace-nowrap text-white shadow-[0_4px_6px_rgba(0,0,0,0.3)] transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-green-500 hover:shadow-[0_6px_8px_rgba(0,0,0,0.4)] active:translate-y-0 active:shadow-[0_2px_4px_rgba(0,0,0,0.3)] max-[576px]:px-[15px] max-[576px]:py-2 max-[576px]:text-sm max-[400px]:px-3 max-[400px]:py-1.5 max-[400px]:text-xs"
      >
        ▶ 開始
      </button>
    </div>

    <!-- グラフ -->
    <div
      id="graph"
      class="absolute top-[70px] left-1/2 z-[999] h-[300px] w-[80%] max-w-[800px] -translate-x-1/2 rounded-lg border p-2.5 shadow-[0_4px_12px_rgba(0,0,0,0.3)] max-[992px]:h-[250px] max-[992px]:w-[90%] max-[576px]:h-[200px] max-[576px]:w-[95%]"
      style="display: block; background-color: rgba(255, 255, 255, 0.9)"
    >
      <canvas id="graphCanvas"></canvas>
    </div>

    <!-- 右上コントロール -->
    <SettingsButton id="toggleModal" />
  </div>
  <!-- ローディングスピナー（p5.jsの初回draw()実行時にts/index.tsで非表示にします） -->
  <LoadingSpinner />

  <script src="./ts/index.ts"></script>
</SimulationLayout>
