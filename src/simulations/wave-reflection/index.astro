---
import SimulationLayout from "../../layouts/SimulationLayout.astro";
import NavBar from "../../components/simulation/NavBar.astro";
import LoadingSpinner from "../../components/simulation/LoadingSpinner.astro";

const title = "波の反射";
---

<SimulationLayout title={title} class="bg-neutral-900" disableContextMenu>
  <NavBar title={title} />

  <div class="w-full p-0 mt-[60px]" id="p5Container">
    <div class="flex justify-center" id="p5Canvas"></div>

    <!-- 凡例 -->
    <div class="absolute top-0 end-0 m-2 mt-12 pt-4">
      <span
        class="me-1 rounded-full px-2 py-1 text-xs text-white"
        style="background-color: #0000ff !important"
      >
        入射波
      </span>
      <span class="me-1 rounded-full bg-red-600 px-2 py-1 text-xs text-white">
        反射波
      </span>
      <span
        class="rounded-full px-2 py-1 text-xs text-white"
        style="background-color: #00a000"
      >
        合成波
      </span>
    </div>

    <!-- 左下ボタンエリア -->
    <div class="absolute bottom-0 start-0 m-3 flex gap-2">
      <button
        class="rounded bg-blue-600 px-3 py-2 text-white hover:bg-blue-500"
        id="moveBtn"
      >
        スタート
      </button>
      <button
        class="rounded bg-amber-500 px-3 py-2 text-neutral-900 hover:bg-amber-400"
        id="modeBtn"
      >
        自由端
      </button>
      <button
        class="rounded bg-neutral-600 px-3 py-2 text-white hover:bg-neutral-500"
        id="resetBtn"
      >
        リセット
      </button>
    </div>
  </div>

  <!-- ローディングスピナー（p5.jsの初回draw()実行時にts/index.tsで非表示にします） -->
  <LoadingSpinner />

  <script src="./ts/index.ts"></script>
</SimulationLayout>
