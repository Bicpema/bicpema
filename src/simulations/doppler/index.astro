---
import SimulationLayout from "../../layouts/SimulationLayout.astro";
import NavBar from "../../components/simulation/NavBar.astro";
import LoadingSpinner from "../../components/simulation/LoadingSpinner.astro";
import SettingsButton from "../../components/simulation/SettingsButton.astro";
import SettingsModal from "../../components/simulation/SettingsModal.astro";

const title = "ドップラー効果";
---

<SimulationLayout
  title={title}
  class="h-full overflow-hidden bg-neutral-900 p-0"
>
  <NavBar title={title} />

  <div
    class="relative mt-[60px] h-[calc(100vh-60px)] w-full overflow-hidden p-0"
    id="p5Container"
  >
    <div class="flex h-full w-full justify-center" id="p5Canvas"></div>

    <!-- モーダルパネル -->
    <SettingsModal id="settingsModal" variant="dark">
      <div class="mb-4">
        <label for="speedInput" class="form-label">
          音源の速度 (m/s)
        </label>
        <input
          type="number"
          class="form-control"
          id="speedInput"
          min="0"
          max="1000"
          value="340"
          step="1"
        />
      </div>
    </SettingsModal>

    <!-- 左下コントロール -->
    <div class="absolute bottom-5 left-5 z-[1000] flex flex-wrap gap-2.5 max-[576px]:bottom-2.5 max-[576px]:left-2.5 max-[576px]:gap-2">
      <button
        id="startButton"
        class="rounded-lg bg-blue-600 px-5 py-2.5 text-base font-bold whitespace-nowrap text-white shadow-[0_4px_6px_rgba(0,0,0,0.3)] transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-[0_6px_8px_rgba(0,0,0,0.4)] active:translate-y-0 active:shadow-[0_2px_4px_rgba(0,0,0,0.3)] max-[576px]:px-[15px] max-[576px]:py-2 max-[576px]:text-sm max-[400px]:px-3 max-[400px]:py-1.5 max-[400px]:text-xs"
      >
        スタート
      </button>
      <button
        id="stopButton"
        class="rounded-lg bg-red-600 px-5 py-2.5 text-base font-bold whitespace-nowrap text-white shadow-[0_4px_6px_rgba(0,0,0,0.3)] transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-red-500 hover:shadow-[0_6px_8px_rgba(0,0,0,0.4)] active:translate-y-0 active:shadow-[0_2px_4px_rgba(0,0,0,0.3)] max-[576px]:px-[15px] max-[576px]:py-2 max-[576px]:text-sm max-[400px]:px-3 max-[400px]:py-1.5 max-[400px]:text-xs"
      >
        ストップ
      </button>
      <button
        id="resetButton"
        class="rounded-lg bg-neutral-600 px-5 py-2.5 text-base font-bold whitespace-nowrap text-white shadow-[0_4px_6px_rgba(0,0,0,0.3)] transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-neutral-500 hover:shadow-[0_6px_8px_rgba(0,0,0,0.4)] active:translate-y-0 active:shadow-[0_2px_4px_rgba(0,0,0,0.3)] max-[576px]:px-[15px] max-[576px]:py-2 max-[576px]:text-sm max-[400px]:px-3 max-[400px]:py-1.5 max-[400px]:text-xs"
      >
        リセット
      </button>
    </div>

    <!-- 右上コントロール -->
    <SettingsButton id="settingsButton" />
  </div>

  <!-- ローディングスピナー（p5.jsの初回draw()実行時にts/index.tsで非表示にします） -->
  <LoadingSpinner />

  <script src="./ts/index.ts"></script>
</SimulationLayout>
