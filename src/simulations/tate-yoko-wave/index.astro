---
import SimulationLayout from "../../layouts/SimulationLayout.astro";
import NavBar from "../../components/simulation/NavBar.astro";
import LoadingSpinner from "../../components/simulation/LoadingSpinner.astro";

const title = "縦横波";
---

<SimulationLayout title={title} class="bg-neutral-900" disableContextMenu>
  <NavBar title={title} />

  <div class="w-full p-0 mt-[60px]" id="p5Container">
    <div class="flex justify-center" id="p5Canvas"></div>
  </div>

  <!-- Bottom-left controls -->
  <div
    class="fixed bottom-0 start-0 m-3 flex items-center gap-2"
    style="z-index: 1000"
  >
    <button
      class="rounded bg-blue-600 px-3 py-2 text-white hover:bg-blue-500"
      id="moveBtn"
    >
      スタート
    </button>
    <button
      class="rounded bg-neutral-600 px-3 py-2 text-white hover:bg-neutral-500"
      id="resetBtn"
    >
      リセット
    </button>
    <div
      class="flex items-center gap-2 rounded px-3 py-2"
      style="background: rgba(255, 255, 255, 0.15)"
    >
      <label class="mb-0 text-sm text-neutral-300" for="speedSlider">
        速度
      </label>
      <input
        type="range"
        class="accent-blue-600"
        id="speedSlider"
        min="10"
        max="60"
        step="1"
        value="30"
        style="width: 120px"
      />
    </div>
  </div>

  <!-- ローディングスピナー（p5.jsの初回draw()実行時にts/index.tsで非表示にします） -->
  <LoadingSpinner />

  <script src="./ts/index.ts"></script>
</SimulationLayout>
