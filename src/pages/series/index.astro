---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import TermIndex from "../../components/TermIndex.astro";
import { countBy, getPosts, seriesUrl } from "../../lib/posts";

const posts = await getPosts();
const series = countBy(posts, (post) => post.data.series);
/** シリーズの代表カテゴリー（アクセントカラーに使う） */
const categoryOf = (name: string) =>
  posts.find((post) => post.data.series.includes(name))?.data.categories[0];
---

<BaseLayout
  title="シリーズ"
  description="学習の順番に沿って並べた教材のまとまりです。"
>
  <PageHeader
    title="シリーズ"
    description="学習の順番に沿って並べた教材のまとまりです。"
    breadcrumbs={[{ label: "シリーズ" }]}
  />
  <div class="mx-auto max-w-6xl px-4 py-10">
    <TermIndex
      icon="collection"
      terms={series.map(([name, count]) => ({
        name,
        count,
        href: seriesUrl(name),
        category: categoryOf(name)
      }))}
    />
  </div>
</BaseLayout>
