---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import PostGrid from "../../../components/PostGrid.astro";
import { getPosts } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const seriesNames = [...new Set(posts.flatMap((post) => post.data.series))];
  return seriesNames.map((series) => ({
    params: { series: series.toLowerCase() },
    props: {
      series,
      // シリーズは学習順（公開日の古い順）に並べる
      posts: posts
        .filter((post) => post.data.series.includes(series))
        .toSorted((a, b) => a.data.date.getTime() - b.data.date.getTime())
    }
  }));
}

const { series, posts } = Astro.props;
---

<BaseLayout
  title={`シリーズ「${series}」`}
  description={`シリーズ「${series}」の物理シミュレーション教材の一覧です。`}
>
  <PageHeader
    title={series}
    description={`学習の順番に並べた ${posts.length}本の教材です。`}
    breadcrumbs={[{ href: "/series/", label: "シリーズ" }, { label: series }]}
  />
  <div class="mx-auto max-w-6xl px-4 py-10">
    <PostGrid posts={posts} />
  </div>
</BaseLayout>
