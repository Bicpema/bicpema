---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PostGrid from "../components/PostGrid.astro";
import { categoryStyle, categoryUrl, countBy, getPosts } from "../lib/posts";

const LATEST_COUNT = 6;

const posts = await getPosts();
const categories = countBy(posts, (post) => post.data.categories);
---

<BaseLayout>
  <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-br from-blue-50 via-white to-cyan-50 dark:border-slate-800 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
      <p class="text-sm font-semibold tracking-wider text-blue-700 dark:text-blue-300">
        中学生・高校生のための物理シミュレーション教材
      </p>
      <h1 class="mt-3 text-4xl leading-tight font-bold tracking-tight sm:text-5xl">
        手元で動かしながら、
        <br class="hidden sm:inline" />
        物理現象を観察しよう。
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        教科書に出てくる物理現象を、ブラウザ上でインタラクティブに体験できます。インストール不要で、スマートフォン・タブレット・PCのいずれでも使えます。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/post/"
          class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-blue-700"
        >
          シミュレーションを探す
          <Icon name="arrow-right" size={18} />
        </a>
        <a
          href="/about/"
          class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-3 font-semibold text-slate-700 transition-colors hover:border-slate-400 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-500"
        >
          Bicpemaについて
        </a>
      </div>
      <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-4">
        <div>
          <dt class="text-sm text-slate-500 dark:text-slate-400">教材</dt>
          <dd class="text-3xl font-bold">
            {posts.length}
            <span class="ml-1 text-base font-medium">本</span>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-slate-500 dark:text-slate-400">分野</dt>
          <dd class="text-3xl font-bold">
            {categories.length}
            <span class="ml-1 text-base font-medium">分野</span>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-slate-500 dark:text-slate-400">利用料金</dt>
          <dd class="text-3xl font-bold">無料</dd>
        </div>
      </dl>
    </div>
  </section>

  <section
    class="mx-auto max-w-6xl px-4 pt-16"
    aria-labelledby="categoriesHeading"
  >
    <h2 id="categoriesHeading" class="text-2xl font-bold">
      分野から探す
    </h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {categories.map(([category, count]) => (
        <li>
          <a
            href={categoryUrl(category)}
            class="group relative block overflow-hidden rounded-xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
          >
            <span
              class:list={[
                "absolute inset-x-0 top-0 h-1 bg-gradient-to-r",
                categoryStyle(category).accent
              ]}
            />
            <span class="block text-lg font-bold group-hover:text-blue-700 dark:group-hover:text-blue-300">
              {category}
            </span>
            <span class="mt-1 block text-sm text-slate-500 dark:text-slate-400">
              {count}本の教材
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-16" aria-labelledby="latestHeading">
    <div class="flex items-end justify-between gap-4">
      <h2 id="latestHeading" class="text-2xl font-bold">
        新着の教材
      </h2>
      <a
        href="/post/"
        class="inline-flex items-center gap-1 text-sm font-semibold text-blue-700 hover:underline dark:text-blue-300"
      >
        すべて見る
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
    <div class="mt-6">
      <PostGrid posts={posts.slice(0, LATEST_COUNT)} headingLevel={3} />
    </div>
  </section>
</BaseLayout>
