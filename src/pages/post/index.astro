---
// シミュレーション（記事）の一覧。キーワード・カテゴリー・対象・タグで絞り込める。
// 絞り込みの条件はURLのクエリ（?q=&category=&grade=&tag=）に反映し、共有・再読み込みできるようにする。
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostGrid from "../../components/PostGrid.astro";
import { countBy, getPosts, GRADE_TAGS } from "../../lib/posts";

/** タグの絞り込みで最初から表示するタグの数（残りは「すべてのタグ」で表示する） */
const VISIBLE_TAG_COUNT = 16;
/** すべての記事に付いており、絞り込みの意味がないタグ */
const EXCLUDED_TAGS = new Set<string>(["物理", ...GRADE_TAGS]);

const posts = await getPosts();
const categories = countBy(posts, (post) => post.data.categories);
const grades = GRADE_TAGS.filter((grade) =>
  posts.some((post) => post.data.tags.includes(grade))
);
const tags = countBy(posts, (post) =>
  post.data.tags.filter(
    (tag) => !EXCLUDED_TAGS.has(tag) && !post.data.categories.includes(tag)
  )
);
---

<BaseLayout
  title="シミュレーション一覧"
  description="Bicpemaの物理シミュレーション教材の一覧です。分野・対象・タグで絞り込めます。"
>
  <PageHeader
    title="シミュレーション一覧"
    description="分野・対象・タグやキーワードで、使いたい教材を絞り込めます。"
    breadcrumbs={[{ label: "シミュレーション一覧" }]}
  />

  <div class="mx-auto max-w-6xl px-4 py-10">
    <form
      id="postFilter"
      class="space-y-5 rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
      aria-label="教材の絞り込み"
      role="search"
    >
      <label class="relative block">
        <span class="sr-only">キーワード</span>
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
          <Icon name="search" size={16} />
        </span>
        <input
          type="search"
          name="q"
          placeholder="キーワードで絞り込む（例: 振り子、斜面）"
          class="h-11 w-full rounded-lg border border-slate-300 bg-white pr-3 pl-9 text-base placeholder:text-slate-400 focus:border-blue-500 dark:border-slate-700 dark:bg-slate-950"
        />
      </label>

      <fieldset>
        <legend class="mb-2 text-sm font-semibold text-slate-700 dark:text-slate-300">
          分野
        </legend>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            class="chip"
            data-filter="category"
            data-value=""
            aria-pressed="true"
          >
            すべて
          </button>
          {categories.map(([category, count]) => (
            <button
              type="button"
              class="chip"
              data-filter="category"
              data-value={category}
              aria-pressed="false"
            >
              {category}
              <span class="text-xs opacity-70">{count}</span>
            </button>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="mb-2 text-sm font-semibold text-slate-700 dark:text-slate-300">
          対象
        </legend>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            class="chip"
            data-filter="grade"
            data-value=""
            aria-pressed="true"
          >
            すべて
          </button>
          {grades.map((grade) => (
            <button
              type="button"
              class="chip"
              data-filter="grade"
              data-value={grade}
              aria-pressed="false"
            >
              {grade}
            </button>
          ))}
        </div>
      </fieldset>

      <!-- タグは数が多いため、スマートフォンでは折りたたんで表示する（PCでは最初から開く） -->
      <details class="group" data-tag-details>
        <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-slate-700 dark:text-slate-300">
          <Icon
            name="chevron-right"
            size={12}
            class="shrink-0 transition-transform group-open:rotate-90"
          />
          <span class="shrink-0">タグ</span>
          <span class="text-xs font-normal text-slate-500 dark:text-slate-400">
            複数選ぶと、すべてのタグを含む教材に絞り込みます
          </span>
        </summary>
        <div
          class="mt-2 flex flex-wrap gap-2"
          data-tag-list
          role="group"
          aria-label="タグ"
        >
          {tags.map(([tag, count], index) => (
            <button
              type="button"
              class:list={["chip", index >= VISIBLE_TAG_COUNT && "hidden"]}
              data-filter="tag"
              data-value={tag}
              data-extra-tag={index >= VISIBLE_TAG_COUNT ? "" : undefined}
              aria-pressed="false"
            >
              <Icon name="tag" size={12} />
              {tag}
              <span class="text-xs opacity-70">{count}</span>
            </button>
          ))}
          {tags.length > VISIBLE_TAG_COUNT && (
            <button
              type="button"
              class="px-2 py-1 text-sm font-semibold text-blue-700 hover:underline dark:text-blue-300"
              aria-expanded="false"
              data-show-all-tags
            >
              すべてのタグ（{tags.length}）
            </button>
          )}
        </div>
      </details>
    </form>

    <div class="mt-8 flex items-center justify-between gap-4">
      <p
        class="text-sm text-slate-600 dark:text-slate-400"
        aria-live="polite"
        data-result-count
      >
        {posts.length}件の教材
      </p>
      <button
        type="button"
        class="hidden text-sm font-semibold text-blue-700 hover:underline dark:text-blue-300"
        data-clear-filter
      >
        条件をクリア
      </button>
    </div>

    <div class="mt-4">
      <PostGrid posts={posts} id="postGrid" eagerCount={6} />
    </div>
    <p
      class="hidden rounded-xl border border-dashed border-slate-300 p-10 text-center text-slate-500 dark:border-slate-700 dark:text-slate-400"
      data-empty
    >
      条件に一致する教材はありません。条件を変えてお試しください。
    </p>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#postFilter")!;
  const keywordInput = form.querySelector<HTMLInputElement>('input[name="q"]')!;
  const cards = [
    ...document.querySelectorAll<HTMLElement>("#postGrid [data-post]")
  ];
  const resultCount = document.querySelector<HTMLElement>(
    "[data-result-count]"
  )!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  const clearButton = document.querySelector<HTMLButtonElement>(
    "[data-clear-filter]"
  )!;
  const showAllTagsButton = document.querySelector<HTMLButtonElement>(
    "[data-show-all-tags]"
  );

  const state = { q: "", category: "", grade: "", tags: new Set<string>() };

  const normalize = (text: string) => text.normalize("NFKC").toLowerCase();
  const chips = (filter: string) => [
    ...form.querySelectorAll<HTMLButtonElement>(`[data-filter="${filter}"]`)
  ];

  const showAllTags = () => {
    for (const chip of form.querySelectorAll("[data-extra-tag]")) {
      chip.classList.remove("hidden");
    }
    showAllTagsButton?.remove();
  };

  const apply = () => {
    const terms = normalize(state.q).split(/\s+/).filter(Boolean);
    let visible = 0;
    for (const card of cards) {
      const tags: string[] = JSON.parse(card.dataset.tags ?? "[]");
      const keywords = normalize(card.dataset.keywords ?? "");
      const matched =
        (state.category === "" || card.dataset.category === state.category) &&
        (state.grade === "" || tags.includes(state.grade)) &&
        [...state.tags].every((tag) => tags.includes(tag)) &&
        terms.every((term) => keywords.includes(term));
      card.hidden = !matched;
      if (matched) {
        visible += 1;
      }
    }
    resultCount.textContent = `${visible}件の教材`;
    empty.classList.toggle("hidden", visible > 0);

    for (const chip of chips("category")) {
      chip.setAttribute(
        "aria-pressed",
        String(chip.dataset.value === state.category)
      );
    }
    for (const chip of chips("grade")) {
      chip.setAttribute(
        "aria-pressed",
        String(chip.dataset.value === state.grade)
      );
    }
    for (const chip of chips("tag")) {
      const pressed = state.tags.has(chip.dataset.value ?? "");
      chip.setAttribute("aria-pressed", String(pressed));
      // 選択中のタグは「すべてのタグ」を開かなくても表示する
      if (pressed) {
        chip.classList.remove("hidden");
      }
    }
    const filtered =
      state.q !== "" ||
      state.category !== "" ||
      state.grade !== "" ||
      state.tags.size > 0;
    clearButton.classList.toggle("hidden", !filtered);

    const params = new URLSearchParams();
    if (state.q) params.set("q", state.q);
    if (state.category) params.set("category", state.category);
    if (state.grade) params.set("grade", state.grade);
    for (const tag of state.tags) params.append("tag", tag);
    const query = params.toString();
    history.replaceState(null, "", query ? `?${query}` : location.pathname);
  };

  const tagDetails =
    form.querySelector<HTMLDetailsElement>("[data-tag-details]")!;

  // URLのクエリから初期状態を復元する
  const params = new URLSearchParams(location.search);
  state.q = params.get("q") ?? "";
  state.category = params.get("category") ?? "";
  state.grade = params.get("grade") ?? "";
  state.tags = new Set(params.getAll("tag"));
  keywordInput.value = state.q;
  tagDetails.open =
    matchMedia("(min-width: 768px)").matches || state.tags.size > 0;

  form.addEventListener("submit", (event) => event.preventDefault());
  keywordInput.addEventListener("input", () => {
    state.q = keywordInput.value.trim();
    apply();
  });
  form.addEventListener("click", (event) => {
    const chip = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-filter]"
    );
    if (!chip) return;
    const value = chip.dataset.value ?? "";
    if (chip.dataset.filter === "category") state.category = value;
    if (chip.dataset.filter === "grade") state.grade = value;
    if (chip.dataset.filter === "tag") {
      if (state.tags.has(value)) {
        state.tags.delete(value);
      } else {
        state.tags.add(value);
      }
    }
    apply();
  });
  showAllTagsButton?.addEventListener("click", showAllTags);
  clearButton.addEventListener("click", () => {
    state.q = "";
    state.category = "";
    state.grade = "";
    state.tags.clear();
    keywordInput.value = "";
    apply();
  });

  apply();
</script>
