---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryBadge from "../../components/CategoryBadge.astro";
import Icon from "../../components/Icon.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostGrid from "../../components/PostGrid.astro";
import SimulationEmbedScript from "../../components/SimulationEmbedScript.astro";
import {
  categoryUrl,
  formatDate,
  getPosts,
  postUrl,
  seriesUrl,
  tagUrl
} from "../../lib/posts";

/** 「関連する教材」に表示する件数 */
const RELATED_COUNT = 3;
/** サイドバーのシリーズに表示する件数（現在の教材の前後を表示する） */
const SERIES_WINDOW = 5;

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts }
  }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, image, categories, series, tags } = post.data;
const category = categories[0];
const toc = headings.filter((heading) => heading.depth === 2);

// 同じシリーズの教材は公開日の古い順（学習順）に並べる
const seriesName = series[0];
const seriesPosts = seriesName
  ? posts
      .filter((other) => other.data.series.includes(seriesName))
      .toSorted((a, b) => a.data.date.getTime() - b.data.date.getTime())
  : [];
const seriesIndex = seriesPosts.findIndex((other) => other.id === post.id);
const seriesStart = Math.max(
  0,
  Math.min(
    seriesIndex - Math.floor(SERIES_WINDOW / 2),
    seriesPosts.length - SERIES_WINDOW
  )
);
const seriesWindow = seriesPosts
  .map((other, index) => ({ post: other, number: index + 1 }))
  .slice(seriesStart, seriesStart + SERIES_WINDOW);
const related = posts
  .filter(
    (other) =>
      other.id !== post.id &&
      other.data.categories.some((c) => categories.includes(c))
  )
  .slice(0, RELATED_COUNT);
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  math
>
  <PageHeader
    title={title}
    breadcrumbs={[
      { href: "/post/", label: "シミュレーション一覧" },
      ...(category ? [{ href: categoryUrl(category), label: category }] : []),
      { label: title }
    ]}
  >
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-600 dark:text-slate-400">
      {category && (
        <CategoryBadge category={category} href={categoryUrl(category)} />
      )}
      <span class="inline-flex items-center gap-1.5">
        <Icon name="calendar3" size={14} />
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </span>
      {seriesName && (
        <a
          href={seriesUrl(seriesName)}
          class="inline-flex items-center gap-1.5 hover:text-blue-700 dark:hover:text-blue-300"
        >
          <Icon name="collection" size={14} />
          シリーズ: {seriesName}
        </a>
      )}
    </div>
    <p class="mt-4 max-w-3xl leading-relaxed text-slate-600 dark:text-slate-300">
      {description}
    </p>
  </PageHeader>

  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <article class="article-body min-w-0">
      <Content />
      <SimulationEmbedScript />
    </article>

    <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
      {toc.length > 0 && (
        <nav aria-labelledby="tocHeading" class="hidden lg:block">
          <h2
            id="tocHeading"
            class="text-sm font-semibold text-slate-900 dark:text-white"
          >
            目次
          </h2>
          <ul class="mt-3 space-y-2 border-l border-slate-200 text-sm dark:border-slate-800">
            {toc.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class="-ml-px block border-l border-transparent pl-3 text-slate-600 hover:border-blue-500 hover:text-blue-700 dark:text-slate-400 dark:hover:text-blue-300"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <section aria-labelledby="tagsHeading">
        <h2
          id="tagsHeading"
          class="text-sm font-semibold text-slate-900 dark:text-white"
        >
          タグ
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li>
              <a href={tagUrl(tag)} class="chip">
                <Icon name="tag" size={12} />
                {tag}
              </a>
            </li>
          ))}
        </ul>
      </section>
      {seriesPosts.length > 1 && (
        <nav aria-labelledby="seriesHeading">
          <h2
            id="seriesHeading"
            class="text-sm font-semibold text-slate-900 dark:text-white"
          >
            <a
              href={seriesUrl(seriesName!)}
              class="hover:text-blue-700 dark:hover:text-blue-300"
            >
              {`シリーズ「${seriesName}」`}
            </a>
          </h2>
          <ol class="mt-3 space-y-1 text-sm">
            {seriesWindow.map(({ post: other, number }) => (
              <li>
                <a
                  href={postUrl(other.id)}
                  aria-current={other.id === post.id ? "page" : undefined}
                  class="flex gap-2 rounded px-2 py-1 text-slate-600 hover:bg-slate-100 aria-[current=page]:bg-blue-50 aria-[current=page]:font-semibold aria-[current=page]:text-blue-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:aria-[current=page]:bg-blue-500/15 dark:aria-[current=page]:text-blue-200"
                >
                  <span class="w-5 shrink-0 text-right tabular-nums opacity-60">
                    {number}
                  </span>
                  {other.data.title}
                </a>
              </li>
            ))}
          </ol>
          {seriesPosts.length > SERIES_WINDOW && (
            <a
              href={seriesUrl(seriesName!)}
              class="mt-2 inline-block px-2 text-sm font-semibold text-blue-700 hover:underline dark:text-blue-300"
            >
              全{seriesPosts.length}本を見る
            </a>
          )}
        </nav>
      )}
    </aside>
  </div>

  {related.length > 0 && (
    <section class="mx-auto max-w-6xl px-4" aria-labelledby="relatedHeading">
      <h2 id="relatedHeading" class="text-2xl font-bold">
        関連する教材
      </h2>
      <div class="mt-6">
        <PostGrid posts={related} headingLevel={3} eagerCount={0} />
      </div>
    </section>
  )}
</BaseLayout>
