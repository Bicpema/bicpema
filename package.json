    "lint:md": "markdownlint-cli2 \"**/*.md\""
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/p5": "^1.7.7",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.62.1",
    "prettier": "3.8.1",
    "sass": "^1.92.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "mathjs": "^15.1.1",
    "modern-screenshot": "^4.7.0",
