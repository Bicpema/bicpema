{
  "name": "simulations",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:runtime": "node scripts/verify-simulation-runtime.js",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "benchmark:performance": "node scripts/benchmark-simulation-performance.js",
    "check:article-links": "node scripts/check-article-simulation-links.js",
    "check:template-compliance": "node scripts/check-simulation-template-compliance.js",
    "lint": "oxlint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:spell": "cspell \"**\" --no-progress"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "cspell": "^10.3.3",
    "markdownlint-cli2": "^0.23.2",
    "oxlint": "^1.85.0",
    "playwright": "^1.62.1",
    "prettier": "3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "mathjs": "^15.1.1",
    "modern-screenshot": "^4.7.0",
    "p5": "2.3.2",
    "p5.sound": "^0.4.1"
  }
}
