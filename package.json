{
  "name": "simulations",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "new:simulation": "node scripts/new-simulation.js",
    "verify:runtime": "node scripts/verify-simulation-runtime.js",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "benchmark:performance": "node scripts/benchmark-simulation-performance.js",
    "check:article-links": "node scripts/check-article-simulation-links.js",
    "check:template-compliance": "node scripts/check-simulation-template-compliance.js",
    "check:published-urls": "node scripts/check-published-urls.js",
    "clean:worktrees": "node scripts/clean-worktrees.js",
    "lint": "oxlint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:spell": "cspell \"**\" --no-progress",
    "lint:yaml": "yamllint --strict ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/p5": "^1.7.7",
    "bootstrap-icons": "^1.13.1",
    "cspell": "^10.3.3",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-tsdoc": "^0.5.3",
    "markdownlint-cli2": "^0.23.3",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "mathjs": "^15.1.1",
    "modern-screenshot": "^4.7.0",
    "p5": "^1.11.13"
  }
}
